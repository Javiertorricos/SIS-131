from qiskit import QuantumCircuit
from qiskit_aer import AerSimulator
# 1. Definicion del circuito: 2 qubits cuanticos y 2 bits clasicos
qc = QuantumCircuit(2, 2)
# 2. Creacion de superposicion equiprobable en el qubit 0
qc.h(0)
# 3. Creacion de entrelazamiento maximo mediante CNOT
qc.cx(0, 1)
# 4. Medicion de los qubits en los registros clasicos
qc.measure([0, 1], [0, 1])
# 5. Visualizacion del circuito en consola
print("CIRCUITO CUANTICO:")
print(qc.draw(output="text"))
# 6. Instanciacion del simulador y ejecucion de 10,000 disparos (shots)
backend = AerSimulator()
shots = 10000
job = backend.run(qc, shots=shots)
counts = job.result().get_counts(qc)
# 7. Presentacion de los resultados estadisticos
print(f"\nRESULTADOS DE LA MEDICION ({shots} disparos):")
for bitstring, count in sorted(counts.items()):
porcentaje = (count / shots) * 100
print(f"Estado |{bitstring}>: {count:5d} ocurrencias ({porcentaje:6.2f}%)")
